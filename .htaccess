# DrawMeOne V2: real public portfolio, retired V1 pages redirect.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_authz_core.c>
  <FilesMatch "(^\.env($|\.)|^\.git|\.sql(\.gz)?$|\.pem$|\.key$|\.bak$|\.dump$)">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?:admin-preview\.html|backend-status\.(?:html|php))$ /studio-admin/index.php [R=302,END,NE,QSD]
  RewriteRule ^(?:commission-preview\.html|commission\.html|account\.html|password-reset\.html|commission-summary\.php|services\.php)$ /#contact [R=302,END,NE,QSD]
  RewriteRule ^(?:policy\.html|policy\.php)$ /privacy.php [R=302,END,NE,QSD]
  RewriteRule ^(?:assets/demo/|data/|concepts\.(?:js|css)$|preview\.(?:js|css)$|commission\.(?:js|css)$|account\.js$|password-reset\.js$|policy\.js$) - [F,END]
  RewriteRule ^sitemap\.xml$ sitemap.php [END]
</IfModule>
