# Keep HTML and JSON revalidated so old versions of the live preview do not linger.
<IfModule mod_headers.c>
  # Prelaunch indexing remains closed even for direct static assets and
  # published artwork. Remove only in an explicitly approved SEO release.
  Header always merge X-Robots-Tag "noindex"
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# Protect accidentally misplaced configuration and database dumps.
# Real secrets must still live OUTSIDE public_html.
<IfModule mod_authz_core.c>
  <FilesMatch "(^\.env($|\.)|^\.git|\.sql(\.gz)?$|\.pem$|\.key$|\.bak$|\.dump$)">
    Require all denied
  </FilesMatch>
</IfModule>

# Dynamically expose published artwork URLs to search engines.
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Retire obsolete mock forms and public setup pages; real workspaces retain their own gates.
  RewriteRule ^(?:admin-preview\.html|backend-status\.(?:html|php))$ /studio-admin/index.php [R=302,END,NE,QSD]
  RewriteRule ^commission-preview\.html$ /commission.html [R=302,END,NE,QSD]
  RewriteRule ^sitemap\.xml$ sitemap.php [END]
</IfModule>
