# Deliberately only the reviewed read-only and gated authentication endpoints are public while signup remains gated.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(?!health\.php$|catalog\.php$|site-settings\.php$|auth/(?:status|signup|login|verify|me|logout|reset-request|reset-confirm)\.php$).* - [F,END]
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
