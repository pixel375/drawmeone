# Example only. NEVER commit real secrets.
# Copy settings into the Hostinger PRIVATE .env, outside public_html.
# Existing DB_HOST / DB_NAME / DB_USER / DB_PASS stay unchanged.
DMO_AUTH_ENABLED=0
DMO_REGISTRATION_ENABLED=0
# Generate a secret yourself with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# DMO_APP_KEY=YOUR_PRIVATE_64_CHARACTER_RANDOM_HEX
# DMO_TURNSTILE_SITE_KEY=PUBLIC_KEY_FROM_CLOUDFLARE
# DMO_TURNSTILE_SECRET=PRIVATE_KEY_FROM_CLOUDFLARE
DMO_MAIL_ENABLED=0
DMO_MAIL_FROM=no-reply@drawmeone.com
# Do NOT enable login or registration until migration 002, CAPTCHA,
# email delivery, abuse controls, and account recovery are verified.

# Admin Phase 3 (no MFA). The switches remain off by default.
DMO_ADMIN_ENABLED=0
# Configure these same shared private keys before a controlled test:
# DMO_APP_KEY=RANDOM_PRIVATE_64_HEX
# DMO_TURNSTILE_SITE_KEY=PUBLIC_CLOUDFLARE_KEY
# DMO_TURNSTILE_SECRET=PRIVATE_CLOUDFLARE_SECRET

# Phase 4: design drafts and published layout/colour/logo controls.
# Keep OFF until a controlled admin-auth security test passes.
DMO_DESIGN_WRITES_ENABLED=0

# Phase 5: artist-configurable tiers and add-ons. All OFF initially.
DMO_PACKAGE_WRITES_ENABLED=0
DMO_PACKAGE_PUBLISH_ENABLED=0
DMO_PRICING_APPROVED=0

# Phase 6: artist-only internal notes and unsent quote drafts.
# Defaults to OFF; customer intake, messages and payments remain gated.
DMO_REQUEST_ADMIN_WRITES_ENABLED=0

# Phase 7: private artwork upload, thumbnails and publish/unpublish.
# Enable only after reviewing Hostinger storage, GD and private backup strategy.
DMO_ARTWORK_WRITES_ENABLED=0

# Phase 8: verified-account customer intake, NOT live until policy and mail QA.
# All must be deliberately configured in private Hostinger .env.
DMO_REQUESTS_ENABLED=0
DMO_REQUEST_TERMS_APPROVED=0
DMO_PRIVACY_PUBLISHED=0
# DMO_REQUEST_POLICY_VERSION=OWNER_APPROVED_REVISION

# Phase 9: authenticated SMTP for account verification/recovery.
# Hostinger Email commonly uses smtp.hostinger.com:465 (implicit TLS);
# 587 requires STARTTLS. Private mailbox must exist with verified DNS.
# Keep customer auth and signup OFF while configuring and testing.
DMO_MAIL_TRANSPORT=
# DMO_SMTP_HOST=smtp.hostinger.com
# DMO_SMTP_PORT=465
# DMO_SMTP_USER=verified-mailbox@drawmeone.com
# DMO_MAIL_FROM=verified-mailbox@drawmeone.com
# DMO_SMTP_PASSWORD_B64=PRIVATE_BASE64_OF_PASSWORD_NOT_ENCRYPTION
# Never commit SMTP credentials to GitHub. Use GitHub Environment Secret
# DMO_SMTP_PASSWORD and the fixed SSH configuration workflow instead.

# Optional explicit artist-triggered customer notices; keep disabled until approved.
DMO_CUSTOMER_NOTIFICATIONS_ENABLED=0

# Private artist-only delivery draft staging. No customer release exists yet.
DMO_DELIVERY_DRAFTS_ENABLED=0

# Manual external payment reconciliation: explicit owner approval required.
DMO_MANUAL_PAYMENT_ENABLED=0
DMO_MANUAL_PAYMENT_TERMS_APPROVED=0

# Paid production and final customer download; owner approval required.
DMO_DELIVERY_RELEASE_ENABLED=0
DMO_DELIVERY_TERMS_APPROVED=0

# Optional customer proof review workflow; disabled until approved.
DMO_ARTWORK_REVIEW_ENABLED=0

# Manual financial exceptions; no provider-side refund capability.
DMO_PAYMENT_EXCEPTIONS_ENABLED=0
DMO_PAYMENT_EXCEPTIONS_TERMS_APPROVED=0

# Optional artist intake control. When enabled, starts paused until configured.
# Cannot override existing registration/auth/terms/commission gates.
DMO_INTAKE_CONTROL_ENABLED=0

# Required exact SHA-256 of the owner-approved immutable app/policies/<version>.json.
# DMO_REQUEST_POLICY_SHA256=64_LOWERCASE_HEX_CHARACTERS
