# Example only. NEVER commit real secrets.
# Copy settings into the Hostinger PRIVATE .env, outside public_html.
# Existing DB_HOST / DB_NAME / DB_USER / DB_PASS stay unchanged.
DMO_AUTH_ENABLED=0
DMO_REGISTRATION_ENABLED=0
# Generate a secret yourself with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# DMO_APP_KEY=YOUR_PRIVATE_64_CHARACTER_RANDOM_HEX
# DMO_TURNSTILE_SITE_KEY=PUBLIC_KEY_FROM_CLOUDFLARE
# DMO_TURNSTILE_SECRET=PRIVATE_KEY_FROM_CLOUDFLARE
DMO_MAIL_ENABLED=0
DMO_MAIL_FROM=no-reply@drawmeone.com
# Do NOT enable login or registration until migration 002, CAPTCHA,
# email delivery, abuse controls, and account recovery are verified.

# Admin Phase 3 (no MFA). The switches remain off by default.
DMO_ADMIN_ENABLED=0
# Configure these same shared private keys before a controlled test:
# DMO_APP_KEY=RANDOM_PRIVATE_64_HEX
# DMO_TURNSTILE_SITE_KEY=PUBLIC_CLOUDFLARE_KEY
# DMO_TURNSTILE_SECRET=PRIVATE_CLOUDFLARE_SECRET

# Phase 4: design drafts and published layout/colour/logo controls.
# Keep OFF until a controlled admin-auth security test passes.
DMO_DESIGN_WRITES_ENABLED=0

# Phase 5: artist-configurable tiers and add-ons. All OFF initially.
DMO_PACKAGE_WRITES_ENABLED=0
DMO_PACKAGE_PUBLISH_ENABLED=0
DMO_PRICING_APPROVED=0

# Phase 6: artist-only internal notes and unsent quote drafts.
# Defaults to OFF; customer intake, messages and payments remain gated.
DMO_REQUEST_ADMIN_WRITES_ENABLED=0

# Phase 7: private artwork upload, thumbnails and publish/unpublish.
# Enable only after reviewing Hostinger storage, GD and private backup strategy.
DMO_ARTWORK_WRITES_ENABLED=0
